<Window x:Class="TS4AnimationBrowser.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TS4 Animation Browser (by Demeterio) v1.9.1" Width="1280" Height="900"
        MinHeight="640" MinWidth="980"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Loaded="MainWindow_Loaded"
        Background="White" Foreground="#202020">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="4*" MinHeight="300" />
            <RowDefinition Height="6" />
            <RowDefinition Height="1.1*" MinHeight="220" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                <Button x:Name="UpdateStatusButton" Width="150" Height="34" Margin="0,0,8,0"
                        Content="Checking updates…" IsEnabled="False"
                        ToolTipService.ShowOnDisabled="True"
                        ToolTip="Checking whether a newer published version is available." Click="UpdateStatus_Click" />
                <Button Width="78" Height="34" Margin="0,0,8,0" Content="Help" Click="Help_Click" />
                <Button x:Name="SelectGameFolderButton" Width="190" Height="34"
                        Content="Select The Sims 4 Folder" Click="SelectGameFolder_Click" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="TS4 Animation Browser (by Demeterio)" FontSize="24" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock Text="Character, object animation and VFX browser for The Sims 4" Foreground="#666666" />
            </StackPanel>
        </DockPanel>

        <Border x:Name="ViewerSurface" Grid.Row="1" BorderBrush="#D0D0D0" BorderThickness="1" Background="#F4F4F4"
                MouseLeftButtonDown="Viewer_MouseLeftButtonDown"
                MouseRightButtonDown="Viewer_MouseRightButtonDown"
                MouseLeftButtonUp="Viewer_MouseButtonUp"
                MouseRightButtonUp="Viewer_MouseButtonUp"
                MouseMove="Viewer_MouseMove"
                MouseWheel="Viewer_MouseWheel">
            <Grid ClipToBounds="True">
                <Viewport3D x:Name="AnimationViewport" ClipToBounds="True">
                    <Viewport3D.Camera>
                        <PerspectiveCamera x:Name="ViewportCamera"
                                           Position="-4,2.4,-4"
                                           LookDirection="4,-1.4,4"
                                           UpDirection="0,1,0"
                                           FieldOfView="42" />
                    </Viewport3D.Camera>
                </Viewport3D>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="7*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Margin="12" Padding="10,8"
                            VerticalAlignment="Top" MaxHeight="420"
                            Background="#EFFFFFFF" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBox x:Name="SelectedTitle" Text="No resource selected"
                                         IsReadOnly="True" IsReadOnlyCaretVisible="True" Focusable="True" IsTabStop="True"
                                         BorderThickness="0" Background="Transparent" Padding="0"
                                         FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"
                                         Cursor="IBeam" />
                                <TextBox x:Name="SelectedDetail" Text="Select an animation or VFX resource from the list below."
                                         IsReadOnly="True" IsReadOnlyCaretVisible="True"
                                         BorderThickness="0" Background="Transparent" Padding="0"
                                         Foreground="#666666" Margin="0,4,0,0"
                                         TextWrapping="Wrap" AcceptsReturn="True" Cursor="IBeam"
                                         TextChanged="SelectedDetail_TextChanged" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Padding="7"
                        Background="#EFFFFFFF" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4">
                    <StackPanel>
                        <Button x:Name="ResetCameraButton" Width="104" Height="28" Content="Reset Camera"
                                ToolTip="Reset to the default three-quarter view and frame the complete scene."
                                Click="ResetCameraFacingAxes_Click" />
                        <Grid Margin="0,6,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="34" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Row="0" Grid.Column="1" Height="28" Content="↑" ToolTip="Tilt camera up" Click="CameraTiltUp_Click" />
                            <Button Grid.Row="1" Grid.Column="0" Height="28" Content="←" ToolTip="Orbit camera left" Click="CameraOrbitLeft_Click" />
                            <Button Grid.Row="1" Grid.Column="1" Height="28" Content="Front" FontSize="9"
                                    ToolTip="Face the Sim or object directly while keeping the complete scene framed."
                                    Click="CameraFront_Click" />
                            <Button Grid.Row="1" Grid.Column="2" Height="28" Content="→" ToolTip="Orbit camera right" Click="CameraOrbitRight_Click" />
                            <Button Grid.Row="2" Grid.Column="1" Height="28" Content="↓" ToolTip="Tilt camera down" Click="CameraTiltDown_Click" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Width="50" Height="27" Margin="0,0,4,0" Content="Zoom +" FontSize="10" Click="CameraZoomIn_Click" />
                            <Button Width="50" Height="27" Content="Zoom -" FontSize="10" Click="CameraZoomOut_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="ViewportMessagePanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Padding="16,10" Background="#EFFFFFFF" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4">
                    <TextBox x:Name="ViewportMessage" Text="Select The Sims 4 folder to begin"
                             IsReadOnly="True" IsReadOnlyCaretVisible="True" Focusable="True" IsTabStop="True"
                             BorderThickness="0" Background="Transparent" Padding="0"
                             Foreground="#555555" FontSize="14" MaxWidth="720"
                             TextWrapping="Wrap" TextAlignment="Center" AcceptsReturn="True" Cursor="IBeam" />
                </Border>

                <Grid x:Name="ViewportLoadingOverlay" Visibility="Collapsed" Background="#66FFFFFF">
                    <Border Width="320" Padding="18" Background="#F8FFFFFF" BorderBrush="#C8C8C8" BorderThickness="1" CornerRadius="5"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock x:Name="ViewportLoadingText" Text="Decoding animation…" FontSize="16" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" TextAlignment="Center" />
                            <TextBlock x:Name="ViewportLoadingDetail" Text="Reading CLIP and searching for a compatible RIG…" Margin="0,6,0,10"
                                       Foreground="#666666" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                            <ProgressBar Height="6" IsIndeterminate="True" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      Background="#E0E0E0" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                      Cursor="SizeNS" />

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="115" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,10,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PlayPauseButton" Width="72" Height="30" Content="Play" Click="PlayPause_Click" IsEnabled="False" />
                    <Button x:Name="StopButton" Width="58" Height="30" Margin="6,0,0,0" Content="Stop" Click="Stop_Click" IsEnabled="False" />
                    <CheckBox x:Name="LoopCheckBox" Content="Loop" IsChecked="False" Margin="12,0,0,0" VerticalAlignment="Center"
                              Checked="LoopChanged" Unchecked="LoopChanged" />
                </StackPanel>

                <Slider x:Name="TimelineSlider" Grid.Column="1" Margin="16,0" Minimum="0" Maximum="1" Value="0"
                        IsEnabled="False" ValueChanged="TimelineSlider_ValueChanged" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TimeText" Text="00:00.00 / 00:00.00" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <TextBlock Text="Speed" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="SpeedComboBox" Width="78" SelectedIndex="2" SelectionChanged="SpeedComboBox_SelectionChanged">
                        <ComboBoxItem Content="0.25x" Tag="0.25" />
                        <ComboBoxItem Content="0.5x" Tag="0.5" />
                        <ComboBoxItem Content="1.0x" Tag="1.0" />
                        <ComboBoxItem Content="1.5x" Tag="1.5" />
                        <ComboBoxItem Content="2.0x" Tag="2.0" />
                    </ComboBox>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Height="32" Margin="0,8,0,8" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Height="32" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox" Height="32" Padding="9,5" VerticalAlignment="Center"
                             TextChanged="ExtendedSearchBox_TextChanged"
                             ToolTip="Search name, kind, type ID, group, instance, pack or package" />
                    <TextBlock x:Name="SearchPlaceholder" Text="Search..." Margin="10,0,0,0" VerticalAlignment="Center"
                               Foreground="#8A8A8A" IsHitTestVisible="False" />
                </Grid>

                <StackPanel Grid.Column="1" Height="32" Orientation="Horizontal" Margin="14,0,0,0"
                            VerticalAlignment="Center">
                    <CheckBox x:Name="HideUnknown" Height="32" Content="Hide Unknown" IsChecked="True" Margin="0,0,14,0"
                              VerticalAlignment="Center" VerticalContentAlignment="Center"
                              ToolTip="Hide CLIPs whose Sim/Object kind cannot be resolved from an exact or reliable compatible RIG."
                              Checked="ExtendedFilterChanged" Unchecked="ExtendedFilterChanged" />
                    <CheckBox x:Name="SimAnimationsOnly" Height="32" Content="Sim / Character" Margin="0,0,14,0"
                              VerticalAlignment="Center" VerticalContentAlignment="Center"
                              ToolTip="Show only CLIPs classified as Sim / Character from their resolved RIG. Unknown CLIPs are not included."
                              Checked="ExtendedFilterChanged" Unchecked="ExtendedFilterChanged" />
                    <CheckBox x:Name="ObjectAnimationsOnly" Height="32" Content="Object" Margin="0,0,14,0"
                              VerticalAlignment="Center" VerticalContentAlignment="Center"
                              ToolTip="Show only CLIPs classified as Object from their resolved RIG. Object previews render the full raw bone hierarchy."
                              Checked="ExtendedFilterChanged" Unchecked="ExtendedFilterChanged" />
                    <CheckBox x:Name="VfxOnly" Height="32" Content="VFX" Margin="0,0,14,0"
                              VerticalAlignment="Center" VerticalContentAlignment="Center"
                              ToolTip="Show only VFX resources."
                              Checked="ExtendedFilterChanged" Unchecked="ExtendedFilterChanged" />
                    <Button Width="74" Height="32" VerticalAlignment="Center" Content="Refresh"
                            ToolTip="Reset search and filters. Hide Unknown returns to its default enabled state."
                            Click="RefreshFilters_Click" />
                </StackPanel>
            </Grid>

            <DataGrid Grid.Row="2" x:Name="ResourcesGrid" AutoGenerateColumns="False"
                      IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserReorderColumns="False" FrozenColumnCount="1"
                      IsSynchronizedWithCurrentItem="True" Loaded="ResourcesGrid_Loaded"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      Background="White" Foreground="#202020"
                      RowBackground="White" AlternatingRowBackground="#F7F7F7"
                      BorderBrush="#D0D0D0" HorizontalGridLinesBrush="#E6E6E6"
                      SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="ResourcesGrid_SelectionChanged"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.PanningMode="VerticalOnly"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="White" />
                        <Setter Property="Foreground" Value="#202020" />
                        <Setter Property="FontWeight" Value="Normal" />
                        <Style.Triggers>
                            <Trigger Property="AlternationIndex" Value="1">
                                <Setter Property="Background" Value="#F7F7F7" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#D8E9F8" />
                                <Setter Property="Foreground" Value="#202020" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter Property="Background" Value="#BFDDF4" />
                                <Setter Property="Foreground" Value="#102A43" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Foreground}" />
                        <Setter Property="FontWeight" Value="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=FontWeight}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter Property="Background" Value="#BFDDF4" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" MinWidth="240" />
                    <DataGridTextColumn Header="Kind" Binding="{Binding Type}" Width="160" />
                    <DataGridTextColumn Header="Type" Binding="{Binding TypeId}" Width="120" />
                    <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="120" />
                    <DataGridTextColumn Header="Instance" Binding="{Binding Instance}" Width="190" />
                    <DataGridTextColumn Header="Pack" Binding="{Binding Pack}" Width="100" />
                    <DataGridTextColumn Header="Package" Binding="{Binding Package}" Width="190" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Border Grid.Row="4" Margin="0,8,0,0" Padding="8,5"
                Background="#F7F7F7" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="3">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="18,0,0,0">
                    <TextBlock x:Name="CountText" Foreground="#666666" VerticalAlignment="Center" />
                    <TextBlock Text="  •  v1.9.1" Foreground="#888888" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="StatusText"
                           Text="Select the main The Sims 4 installation folder to begin."
                           Foreground="#666666" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Grid x:Name="LoadingOverlay" Grid.RowSpan="5" Visibility="Collapsed" Background="#CCFFFFFF"
              IsVisibleChanged="LoadingOverlay_IsVisibleChanged">
            <Border Width="500" Padding="28" Background="White" BorderBrush="#C8C8C8" BorderThickness="1" CornerRadius="6"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="LoadingText" Text="Scanning The Sims 4…" FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock x:Name="LoadingDetail" Text="Finding client packages…" Margin="0,10,0,14"
                               Foreground="#666666" HorizontalAlignment="Center" TextAlignment="Center" />
                    <ProgressBar Height="5" IsIndeterminate="True" Margin="0,0,0,14" />
                    <ProgressBar x:Name="LoadingProgress" Height="8" Minimum="0" Maximum="1" Value="0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>